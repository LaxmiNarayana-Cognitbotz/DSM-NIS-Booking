# Copy this file to ".env" and fill in the values.
# The .env file is git-ignored so secrets stay out of source control.

# ── Microsoft Azure AD / Graph API (Outlook & SharePoint) ──────────────────────
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
USER_EMAIL=

SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=

# ── SharePoint / OneDrive ─────────────────────────────────────────────────────
SP_TENANT_HOST=
SP_SITE_NAME=
SP_DRIVE_NAME=
SP_FOLDER_PATH=
SP_FILE_NAME=
SP_INPUT_FILE_NAME=
SP_INPUT_SHEET_NAME=
SP_OUTPUT_FILE_NAME=
SP_TARGET_SHEET=
SP_BOOKING_BASE=

# ── NIS Portal (Playwright Automation) ────────────────────────────────────────
NIS_LOGIN_URL=
NIS_EDGE_PATH=
NIS_AUTH_FILE=
NIS_USERNAME=
NIS_PASSWORD=
NIS_OTP_SECRET=
NIS_USE_COOKIES=false

# ── SAP GUI Automation ────────────────────────────────────────────────────────
SAP_LOGON_PATH=
SAP_SYSTEM=
SAP_CLIENT=
SAP_USERNAME=
SAP_PASSWORD=
SAP_LANGUAGE=EN
SAP_CHK_DOC_TYP=44
SAP_DIG_SIGN_INV=X
SAP_GJAHR=2025
SAP_DEB_NOT_REF=DSM192501
SAP_DOC_SUB_CAT=36
SAP_DO_PREVIEW=true

# ── Invoice-number LLM backend ───────────────────────────────────────────────
NIS_SKIP_INVOICE_EXTRACTION=false
LLM_USE_OPENAI_DIRECT=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Internal Azure OpenAI (llm_client) — optional overrides ──────────────────
LLM_ENDPOINT=
LLM_DEPLOYMENT=
LLM_API_VERSION=2023-05-15
LLM_API_KEY=

# ── Database Backend ──────────────────────────────────────────────────────────
# "sqlite" (default) — uses a local .db file
# "postgres" — uses a PostgreSQL server; tables are auto-created if missing
DB_BACKEND=sqlite
SQLITE_DB_PATH=

# PostgreSQL connection (only used when DB_BACKEND=postgres)
# You can set a full DSN or individual params. DSN takes precedence.
POSTGRES_DSN=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# ── SAP Automation Timeout Settings ───────────────────────────────────────────
SAP_MAX_STEP_RETRIES=3
SAP_PRINT_DIALOG_WAIT=5
SAP_SAVE_DIALOG_CONNECT_TIMEOUT=15
SAP_SAVE_DIALOG_VISIBLE_TIMEOUT=10
SAP_SAVE_DIALOG_RETRIES=3
